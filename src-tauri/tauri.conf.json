{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIna-sensei",
  "version": "1.2.1",
  "identifier": "com.aina.sensei",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIna-sensei Settings",
        "width": 850,
        "height": 650,
        "resizable": true
      },
      {
        "label": "snipper",
        "title": "Snipper Overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "hud",
        "title": "AIna-sensei HUD",
        "width": 450,
        "height": 350,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNTlEMTEwNkNFRDU0MDkKUldRSlZPMXNFTkZaWWVrcEVObFVTUkI1bkd2NmJFazJudzhwbUYzWmNqT0paTTNhOFNlck1ZdEEK",
      "endpoints": [
        "https://raw.githubusercontent.com/mmuramatsu/AIna-sensei/main/updater.json"
      ]
    }
  }
}
